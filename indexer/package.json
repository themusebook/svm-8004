{
  "name": "@musebook/svm-8004-indexer",
  "version": "0.1.0",
  "description": "Musebook 8004 indexer: ingest deployed AgentRegistry / ATOM programs and serve the REST shape used by @musebook/svm-8004.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "svm-8004-indexer": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
