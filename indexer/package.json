  },
  "dependencies": {
    "@musebook/svm-8004": "file:..",
    "@solana/web3.js": "^1.99.0",
    "better-sqlite3": "^12.6.2",
    "bs58": "^6.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.11.10",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
